# PrimaCard API - Environment Variables para Vercel

# Copie estas variáveis para Vercel Dashboard > Settings > Environment Variables

# ===================
# 🗄️ DATABASE
# ===================
# Usar Neon (https://neon.tech) ou Supabase (https://supabase.com)
# IMPORTANTE: Incluir ?sslmode=require&pgbouncer=true para serverless
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require&pgbouncer=true

# ===================
# 🔐 JWT SECRETS
# ===================
# GERAR com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NÃO usar os exemplos abaixo! Gere novos secrets únicos!
JWT_SECRET=GERAR_UM_SECRET_UNICO_DE_64_CARACTERES_MINIMO_MUITO_SEGURO_NUNCA_COMPARTILHAR
JWT_REFRESH_SECRET=GERAR_OUTRO_SECRET_DIFERENTE_DO_ANTERIOR_64_CARACTERES_MINIMO_SEGURO

# ===================
# 👤 ADMIN
# ===================
# GERAR com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=GERAR_UMA_CHAVE_ADMIN_SUPER_SECRETA_32_CARACTERES_MINIMO

# ===================
# 📧 EMAIL (SMTP)
# ===================
# Gmail: Ativar 2FA e gerar senha de app em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu.email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_do_gmail_16_caracteres

# ===================
# 🌐 CORS
# ===================
# URL do seu frontend (pode ser múltiplas URLs separadas por vírgula)
FRONTEND_URL=https://seu-frontend.vercel.app

# ===================
# ⚙️ ENVIRONMENT
# ===================
NODE_ENV=production

# ===================
# 📝 OPCIONAL
# ===================
# PORT=3000  (Vercel define automaticamente, não precisa configurar)

# ===================
# 🔒 SEGURANÇA
# ===================
# NUNCA commite este arquivo com valores reais!
# NUNCA compartilhe seus secrets!
# Use valores diferentes para dev/staging/prod!

# ===================
# 🎯 PASSO A PASSO
# ===================
# 1. Gerar secrets seguros (comandos acima)
# 2. Configurar database (Neon/Supabase)
# 3. Configurar SMTP (Gmail com senha de app)
# 4. Copiar cada variável para Vercel Dashboard
# 5. Deploy!

# ===================
# 🧪 VERIFICAR
# ===================
# Após deploy, testar:
# - GET https://seu-projeto.vercel.app/health
# - GET https://seu-projeto.vercel.app/api-docs
# - POST https://seu-projeto.vercel.app/api/v1/auth/login
